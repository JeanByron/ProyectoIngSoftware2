          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "jpg/png, máx 5 MB"
                  },
                  "observation": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Adjuntada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Evidence"
                }
              }
            }
          },
          "413": {
            "description": "Archivo demasiado grande"
          }
        }
      }
    },
    "/settings/approval-threshold": {
      "get": {
        "tags": [
          "Configuración"
        ],
        "summary": "Umbral de aprobación de compras grandes",
        "x-roles": [
          "ADMIN",
          "GERENTE",
          "JEFE_COMPRAS"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalThreshold"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Configuración"
        ],
        "summary": "Actualizar umbral",
        "x-roles": [
          "ADMIN",
          "GERENTE"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalThreshold"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalThreshold"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Health check",
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Size": {
        "name": "size",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "UpdatedSince": {
        "name": "updatedSince",
        "in": "query",
        "description": "Sondeo incremental de Reportes",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "SupplierIdPath": {
        "name": "supplierId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "OrderIdPath": {
        "name": "orderId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      },
      "ReturnIdPath": {
        "name": "returnId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Datos inválidos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Rol sin permiso o supera umbral",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "No encontrado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "Duplicado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "InvalidState": {
        "description": "Transición de estado no permitida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "DownstreamError": {
        "description": "Inventario no disponible; la operación local se revirtió y puede reintentarse con el mismo Idempotency-Key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "OrderOk": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PurchaseOrder"
            }
          }
        }
      },
      "ReturnOk": {
        "description": "OK",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SupplierReturn"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "INVALID_STATE"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PageMeta": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          },
          "service": {
            "type": "string"
          },
          "db": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          },
          "dependencies": {
            "type": "object",
            "properties": {
              "inventario": {
                "type": "string",
                "enum": [
                  "UP",
                  "DOWN"
                ]
              }
            }
          }
        }
      },
      "SupplierInput": {
        "type": "object",
        "required": [
          "nit",
          "name"
        ],
        "properties": {
          "nit": {
            "type": "string",
            "example": "900123456-7"
          },
          "name": {
            "type": "string",
            "example": "Agroquímicos del Café S.A.S."
          },
          "type": {
            "type": "string",
            "enum": [
              "MULTINACIONAL",
              "IMPORTADOR",
              "COOPERATIVA",
              "FABRICANTE_NACIONAL"
            ]
          },
          "contactName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "defaultLeadTimeDays": {
            "type": "integer",
            "example": 8
          }
        }
      },
      "Supplier": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "active": {
                "type": "boolean"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          {
            "$ref": "#/components/schemas/SupplierInput"
          }
        ]
      },
      "SupplierProduct": {
        "type": "object",
        "required": [
          "productId",
          "unitPrice"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "productCode": {
            "type": "string",
            "readOnly": true
          },
          "productName": {
            "type": "string",
            "readOnly": true
          },
          "supplierCode": {
            "type": "string",
            "description": "Código del producto en el proveedor"
          },
          "unitPrice": {
            "type": "number",
            "format": "double"
          },
          "leadTimeDays": {
            "type": "integer"
          }
        }
      },
      "PurchaseOrderStatus": {
        "type": "string",
        "enum": [
          "BORRADOR",
          "APROBADA",
          "ENVIADA",
          "RECIBIDA_PARCIAL",
          "RECIBIDA",
          "CANCELADA"
        ]
      },
      "PurchaseOrderInput": {
        "type": "object",
        "required": [
          "supplierId",
          "destinationWarehouseId",
          "lines"
        ],
        "properties": {
          "supplierId": {
            "type": "integer"
          },
          "destinationWarehouseId": {
            "type": "string",
            "example": "CHI"
          },
          "expectedDeliveryDate": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "productId",
                "quantity",
                "unitPrice"
              ],
              "properties": {
                "productId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number",
                  "minimum": 0.01
                },
                "unitPrice": {
                  "type": "number",
                  "format": "double"
                }
              }
            }
          }
        }
      },
      "PurchaseOrderLine": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "productId": {
            "type": "string"
          },
          "productCode": {
            "type": "string"
          },
          "productName": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "requiresLot": {
            "type": "boolean"
          },
          "quantity": {
            "type": "number"
          },
          "receivedQuantity": {
            "type": "number"
          },
          "pendingQuantity": {
            "type": "number"
          },
          "unitPrice": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      },
      "PurchaseOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "number": {
            "type": "string",
            "example": "OC-2026-0142"
          },
          "supplierId": {
            "type": "integer"
          },
          "supplierName": {
            "type": "string"
          },
          "destinationWarehouseId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PurchaseOrderStatus"
          },
          "total": {
            "type": "number"
          },
          "expectedDeliveryDate": {
            "type": "string",
            "format": "date"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PurchaseOrderLine"
            }
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "$ref": "#/components/schemas/PurchaseOrderStatus"
                },
                "userId": {
                  "type": "integer"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          },
          "createdBy": {
            "type": "integer"
          },
          "approvedBy": {
            "type": "integer",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReceiptInput": {
        "type": "object",
        "required": [
          "warehouseId",
          "lines"
        ],
        "properties": {
          "warehouseId": {
            "type": "string"
          },
          "deliveryNote": {
            "type": "string",
            "description": "Remisión del proveedor"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "lineId",
                "quantity"
              ],
              "properties": {
                "lineId": {
                  "type": "integer"
                },
                "quantity": {
                  "type": "number",
                  "minimum": 0.01
                },
                "lotNumber": {
                  "type": "string",
                  "description": "Obligatorio si requiresLot"
                },
                "expiryDate": {
                  "type": "string",
                  "format": "date",
                  "description": "Obligatorio si requiresLot"
                }
              }
            }
          }
        }
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "= Idempotency-Key"
          },
          "purchaseOrderId": {
            "type": "integer"
          },
          "warehouseId": {
            "type": "string"
          },
          "deliveryNote": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lineId": {
                  "type": "integer"
                },
                "productId": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "lotNumber": {
                  "type": "string",
                  "nullable": true
                },
                "expiryDate": {
                  "type": "string",
                  "format": "date",
                  "nullable": true
                }
              }
            }
          },
          "inventoryMovementIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "receivedBy": {
            "type": "integer"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "onTime": {
            "type": "boolean",
            "description": "receivedAt <= expectedDeliveryDate"
          }
        }
      },
      "SupplierReturnStatus": {
        "type": "string",
        "enum": [
          "SOLICITADA",
          "ENVIADA",
          "ACEPTADA",
          "RECHAZADA"
        ]
      },
      "SupplierReturnInput": {
        "type": "object",
        "required": [
          "supplierId",
          "purchaseOrderId",
          "warehouseId",
          "lines",
          "reason"
        ],
        "properties": {
          "supplierId": {
            "type": "integer"
          },
          "purchaseOrderId": {
            "type": "integer"
          },
          "warehouseId": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "VENCIMIENTO",
              "DANO",
              "DEFECTO"
            ]
          },
          "observations": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "productId",
                "quantity"
              ],
              "properties": {
                "productId": {
                  "type": "string"
                },
                "lotNumber": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number",
                  "minimum": 0.01
                }
              }
            }
          }
        }
      },
      "Evidence": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          },
          "uploadedBy": {
            "type": "integer"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SupplierReturn": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "number": {
                "type": "string",
                "example": "DEV-P-2026-0031"
              },
              "status": {
                "$ref": "#/components/schemas/SupplierReturnStatus"
              },
              "evidences": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Evidence"
                }
              },
              "resolution": {
                "type": "string",
                "nullable": true
              },
              "inventoryMovementIds": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "createdBy": {
                "type": "integer"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          {
            "$ref": "#/components/schemas/SupplierReturnInput"
          }
        ]
      },
      "ApprovalThreshold": {
        "type": "object",
        "required": [
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "example": "20000000, description: COP"
          }
        }
      }
    }
  }
}