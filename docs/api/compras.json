    "/purchase-orders/{orderId}/receipts": {
      "parameters": [
        {
          "$ref": "#/components/parameters/OrderIdPath"
        }
      ],
      "get": {
        "tags": [
          "Recepciones"
        ],
        "summary": "Recepciones de la orden",
        "x-roles": [
          "GERENTE",
          "JEFE_COMPRAS",
          "AUX_COMPRAS",
          "JEFE_BODEGA",
          "AUDITOR"
        ],
        "responses": {
